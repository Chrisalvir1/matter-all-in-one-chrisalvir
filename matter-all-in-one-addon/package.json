{
  "name": "matter-all-in-one-addon",
  "version": "2.0.0",
  "description": "Matterbridge all-in-one addon with local storage, web UI and Home Assistant Ingress support with complete Scrypted, BLE, Smart Dimmers, Vacuum, AC, Climate, Lock and Multi-Platform ecosystem compatibility",
  "author": "chrisalvir",
  "license": "Apache-2.0",
  "repository": "https://github.com/Chrisalvir1/matter-all-in-one-chrisalvir",
  "bugs": "https://github.com/Chrisalvir1/matter-all-in-one-chrisalvir/issues",
  "homepage": "https://github.com/Chrisalvir1/matter-all-in-one-chrisalvir",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@homebridge/hap-nodejs": "2.2.3",
    "@scrypted/client": "^1.3.26",
    "@scrypted/types": "^0.5.55",
    "lucide-react": "^1.52.0",
    "mqtt": "^5.16.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "undici": "^8.11.2",
    "werift": "^0.25.0",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "matterbridge": ">= 3.10.8"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "matterbridge": "^3.10.12",
    "prettier": "^3.9.9",
    "qrcode": "^1.5.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && tsc -p src/frontend/tsconfig.json && vite build",
    "build:backend": "tsc -p tsconfig.build.json",
    "build:frontend": "tsc -p src/frontend/tsconfig.json && vite build",
    "generate-ptz-matter": "node scripts/generate-ptz-matter.mjs",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc -p src/frontend/tsconfig.json",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "matter",
    "matter-1.6",
    "matter-1.6.1",
    "homekit",
    "home-assistant",
    "matterbridge",
    "iot",
    "smart-home"
  ],
  "matterbridge": {
    "name": "matter-all-in-one-chrisalvir",
    "version": "1.9.55",
    "author": "chrisalvir",
    "description": "Standards-based Matter 1.6.1 bridge for Home Assistant"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "ip-address": "10.7.2"
  }
}
