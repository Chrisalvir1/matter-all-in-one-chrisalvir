{
  "name": "matter-all-in-one-chrisalvir",
  "version": "1.2.70",
  "description": "Standards-based Matter bridge for Home Assistant - HomeKit compatible mappings",
  "author": "chrisalvir",
  "license": "Apache-2.0",
  "repository": "https://github.com/Chrisalvir1/matter-all-in-one-chrisalvir",
  "bugs": "https://github.com/Chrisalvir1/matter-all-in-one-chrisalvir/issues",
  "homepage": "https://github.com/Chrisalvir1/matter-all-in-one-chrisalvir",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "matterbridge": ">= 3.10.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^3.2.7",
    "matterbridge": "3.10.2",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json && mkdir -p dist/frontend && cp src/frontend/* dist/frontend/",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "matter",
    "matter-1.6",
    "homekit",
    "home-assistant",
    "matterbridge",
    "iot",
    "smart-home"
  ],
  "matterbridge": {
    "name": "matter-all-in-one-chrisalvir",
    "version": "1.2.70",
    "author": "chrisalvir",
    "description": "Standards-based Matter 1.6 bridge for Home Assistant"
  }
}
