{
  "name": "matter-all-in-one-chrisalvir",
  "version": "1.4.69",
  "description": "Standards-based Matter bridge for Home Assistant - HomeKit compatible mappings",
  "author": "chrisalvir",
  "license": "Apache-2.0",
  "repository": "https://github.com/Chrisalvir1/matter-all-in-one-chrisalvir",
  "bugs": "https://github.com/Chrisalvir1/matter-all-in-one-chrisalvir/issues",
  "homepage": "https://github.com/Chrisalvir1/matter-all-in-one-chrisalvir",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@scrypted/client": "^1.3.26",
    "@scrypted/types": "^0.5.55",
    "hap-nodejs": "^0.14.3",
    "mqtt": "^5.15.2",
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "matterbridge": ">= 3.10.7"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.0-rc.4",
    "matterbridge": "^3.10.7",
    "prettier": "^3.9.6",
    "qrcode": "^1.5.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0-rc.4"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json && mkdir -p dist/frontend && cp src/frontend/* dist/frontend/",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "matter",
    "matter-1.6",
    "homekit",
    "home-assistant",
    "matterbridge",
    "iot",
    "smart-home"
  ],
  "matterbridge": {
    "name": "matter-all-in-one-chrisalvir",
    "version": "1.4.61",
    "author": "chrisalvir",
    "description": "Standards-based Matter 1.6 bridge for Home Assistant"
  }
}
