{
  "name": "matter-all-in-one-chrisalvir",
  "version": "1.5.69",
  "description": "Matter all-in-one Home Assistant Add-on with complete Scrypted, BLE, Smart Dimmers, Vacuum, AC, Climate, Lock and Multi-Platform ecosystem compatibility",
  "author": "chrisalvir",
  "license": "Apache-2.0",
  "repository": "https://github.com/Chrisalvir1/matter-all-in-one-chrisalvir",
  "bugs": "https://github.com/Chrisalvir1/matter-all-in-one-chrisalvir/issues",
  "homepage": "https://github.com/Chrisalvir1/matter-all-in-one-chrisalvir",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@scrypted/client": "^1.3.26",
    "@scrypted/types": "^0.5.55",
    "hap-nodejs": "^0.14.3",
    "lucide-react": "^1.45.0",
    "mqtt": "^5.15.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "werift": "^0.24.4",
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "matterbridge": ">= 3.10.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "matterbridge": "^3.10.9",
    "prettier": "^3.9.6",
    "qrcode": "^1.5.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc -p src/frontend/tsconfig.json && vite build",
    "build:backend": "tsc -p tsconfig.build.json",
    "build:frontend": "tsc -p src/frontend/tsconfig.json && vite build",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc -p src/frontend/tsconfig.json",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "matter",
    "matter-1.6",
    "homekit",
    "home-assistant",
    "matterbridge",
    "iot",
    "smart-home"
  ],
  "matterbridge": {
    "name": "matter-all-in-one-chrisalvir",
    "version": "1.5.52",
    "author": "chrisalvir",
    "description": "Standards-based Matter 1.6 bridge for Home Assistant"
  }
}
